# Odwołania2JSON: konfiguracja modelu językowego.
# Skopiuj ten plik jako .env i wklej klucz API po znaku = w wierszu API_KEY.
# Plik .env jest ignorowany przez git: klucz nie trafia do repozytorium.

# Klucz API IONOS AI Model Hub (podany w formularzu zgłoszenia).
API_KEY=

# Model: Qwen3.5 9B (open source, Apache 2.0) w IONOS AI Model Hub, serwery w UE (Niemcy).
LLM_PROVIDER=chat
LLM_BASE_URL=https://openai.inference.de-txl.ionos.com/v1
LLM_MODEL=Qwen/Qwen3.5-9B

# Bez trybu „myślenia”: szybciej, taniej i bez ucinania odpowiedzi JSON.
LLM_EXTRA_BODY={"reasoning_effort": "none"}
