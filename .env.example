# KIOdczyt (Odwołania2JSON): konfiguracja modelu językowego.
# Skopiuj ten plik jako .env i wklej klucz API po znaku = w wierszu LLM_API_KEY.
# Plik .env jest ignorowany przez git: klucz nie trafia do repozytorium.

# Klucz API HostYourAI (podany w formularzu zgłoszenia).
LLM_API_KEY=

# Model: Qwen3.5 9B (open source, Apache 2.0) przez HostYourAI B.V. (Holandia),
# przetwarzanie wyłącznie w centrach danych w UE. Endpoint zgodny z OpenAI Chat Completions.
LLM_PROVIDER=chat
LLM_BASE_URL=https://hostyourai.com/api/v1
LLM_MODEL=Qwen/Qwen3.5-9B

# Bez trybu „myślenia”: szybciej i bez ucinania odpowiedzi JSON.
LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false}}

# Tempo zapytań: 3 PDF-y naraz, co najmniej 1 s między startami zapytań.
# Chwilowe błędy dostawcy (429, 5xx) są ponawiane; po wyczerpaniu ponowień plik dostaje wynik awaryjny z reguł.
LLM_CONCURRENCY=3
LLM_REQUEST_INTERVAL_SECONDS=1
LLM_MAX_429_RETRIES=10
LLM_MAX_RETRY_WAIT_SECONDS=120
LLM_TIMEOUT_SECONDS=90

# Skany (strony bez warstwy tekstowej) czyta ten sam model z obrazu strony: szybciej niż przepisywanie tekstu.
SCAN_MODE=image
